# Databricks SQL Warehouse connection
DATABRICKS_HOST=<your-workspace-id>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<your-warehouse-id>
DATABRICKS_TOKEN=<your-databricks-personal-access-token>

# Warehouse ID — if blank, derived automatically from DATABRICKS_HTTP_PATH
DATABRICKS_SQL_WAREHOUSE_ID=<your-warehouse-id>

# Table to sync into the data store
DATABRICKS_CATALOG=hackathon_db
DATABRICKS_SCHEMA=inventory_system
DATABRICKS_TABLE=products
DATABRICKS_ID_COLUMN=product_id
# Optional: enables incremental sync (only rows changed since last run)
DATABRICKS_UPDATED_COLUMN=last_updated

# GCP / Vertex AI Search (Discovery Engine)
GCP_PROJECT_ID=<your-gcp-project-id>
GCP_LOCATION=global
DATASTORE_ID=databricks-inventory-datastore
DATASTORE_DISPLAY_NAME=Databricks Inventory

# Sync behavior: "once" for a single pass (e.g. triggered by Cloud Scheduler),
# "loop" to run continuously for near-real-time updates
SYNC_MODE=once
SYNC_INTERVAL_SECONDS=60

# Shared secret for the unified API (reads + writes).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WRITEBACK_API_KEY=<generate-a-long-random-secret>

# Local test harness (run_gemini.py) only
GEMINI_API_KEY=<your-gemini-api-key>
DATABRICKS_PAT=<same-as-DATABRICKS_TOKEN>
CONNECTOR_URL=http://localhost:8000
